# ==============================================================================
# Proper Group Chat Search - Environment Variables Configuration
# ==============================================================================
# NEVER commit your actual .env file with live secrets to GitHub!
# Copy this file to .env and insert your personal API key:
#   copy .env.example .env
# ==============================================================================

# OpenRouter API Key for Conversational Chat Copilot
# Get your API key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# (Optional) Comma-separated list of allowed CORS origins.
# Defaults to: http://127.0.0.1:8000,http://localhost:8000,http://127.0.0.1:3000,http://localhost:3000
# ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
